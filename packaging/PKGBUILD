# Maintainer: Hamza Qazi
# bead: an opinionated desktop shell for Hyprland, built with Quickshell.
# After installing, run `bead-setup` once: it writes your keybinds
# (~/.config/hypr/bead.lua) and sets up the optional parts.
pkgname=bead-shell-git
_name=bead
pkgver=0.5.1
pkgrel=1
pkgdesc="An opinionated desktop shell for Hyprland, built with Quickshell: soft pills that morph, an island launcher, voice, all coloured by your wallpaper"
arch=(x86_64 aarch64)
url="https://github.com/HamzaQaz/bead"
license=(GPL-3.0-only)
depends=(
	quickshell hyprland hyprpolkitagent pipewire
	ttf-material-symbols-variable inter-font noto-fonts noto-fonts-emoji
	python jq curl fd libqalculate wtype wl-clipboard cliphist
	grim slurp ffmpeg wf-recorder hyprpicker libnotify
	pacman-contrib expac ddcutil bluez-utils xdg-utils imagemagick
)
makedepends=(git go qt6-shadertools make)
optdepends=(
	'kitty: a terminal for AUR builds and updates (or any terminal in $TERMINAL)'
	'whisper-cpp: Murmur, voice commands and dictation'
	'llama-cpp: Murmur, voice commands'
	'satty: drawing on screenshots'
	'hyprsunset: night light'
	'power-profiles-daemon: power modes'
	'flatpak: installing apps from Flathub'
	'paru: installing apps from the AUR'
	'kdeconnect: Phone link, your phone in bead (battery, ring it, send it links)'
)
provides=(bead-shell)
conflicts=(bead-shell)
install=bead.install
source=("$_name::git+$url.git")
sha256sums=(SKIP)

pkgver() {
	cd "$_name"
	# v0.1.0-3-gabc1234 → 0.1.0.r3.gabc1234
	git describe --long --tags --abbrev=7 --match 'v[0-9]*' 2>/dev/null | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g' ||
		printf '%s.r%s.g%s' "$(cat VERSION)" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
	cd "$_name"
	make build glint strand
}

check() {
	cd "$_name"
	(cd strand && go test ./...)
}

package() {
	cd "$_name"
	make install-files install-glint DESTDIR="$pkgdir" PREFIX=/usr
	# strand, as bead-setup: it finds bead next to itself (/usr/share/bead)
	install -Dm755 strand/strand "$pkgdir/usr/share/bead/strand"
	ln -s /usr/share/bead/strand "$pkgdir/usr/bin/bead-setup"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

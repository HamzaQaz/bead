#!/bin/sh
# bead [start|stop|restart|claim|brightness up|down|notifs|dashboard|island|launcher|clip|emoji|ask|timer|shot|record|pick|wallpaper|special|lock|idle|log]: run the shell in the background.
# claim: take the notification service back from Caelestia by restarting it
# (its server then waits behind ours).
share=${XDG_DATA_HOME:-$HOME/.local/share}/bead
case ${1:-start} in
start)
	mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/bead"
	qs -p "$share" kill >/dev/null 2>&1
	QT_SCALE_FACTOR=${BEAD_SCALE:-1.35} exec qs -p "$share" -n -d ;;
stop) exec qs -p "$share" kill ;;
restart) "$0" stop; "$0" start; sleep 1; exec "$0" claim ;;
claim)
	owner=$(busctl --user status org.freedesktop.Notifications 2>/dev/null | sed -n 's/^CommandLine=//p')
	case $owner in
	*caelestia*) qs -c caelestia kill >/dev/null 2>&1; sleep 0.5; setsid -f caelestia shell -d >/dev/null 2>&1 ;;
	esac ;;
brightness) # bead brightness up|down
	case $2 in up) f=brightnessUp ;; down) f=brightnessDown ;; *) echo "usage: bead brightness up|down" >&2; exit 2 ;; esac
	exec qs -p "$share" ipc call osd "$f" ;;
notifs) # bead notifs [toggle|open|close|clear|dnd]
	exec qs -p "$share" ipc call notifs "${2:-toggle}" ;;
dashboard) # bead dashboard [toggle|open|close|tab N]
	exec qs -p "$share" ipc call dashboard "${2:-toggle}" ${3:+"$3"} ;;
idle) # bead idle [status|keepawake]: keepawake toggles; idle locking pauses while on
	case ${2:-status} in keepawake) f=toggle ;; *) f=${2:-status} ;; esac
	exec qs -p "$share" ipc call idle "$f" ;;
shot) # bead shot [area|window|screen]
	exec qs -p "$share" ipc call capture shot "${2:-area}" ;;
record) # bead record [screen|area] [sound]: starts, or stops the running recording
	f=record; [ "${3:-}" = sound ] && f=recordSound
	exec qs -p "$share" ipc call capture "$f" "${2:-screen}" ;;
pick) exec qs -p "$share" ipc call capture pick ;;
wallpaper) # bead wallpaper [random [still|live]|still PATH|live ID|current]
	case ${2:-current} in
	random) exec qs -p "$share" ipc call wallpaper random "${3:-all}" ;;
	still) exec qs -p "$share" ipc call wallpaper still "$(realpath -- "$3")" ;;
	live) exec qs -p "$share" ipc call wallpaper live "$3" ;;
	*) exec qs -p "$share" ipc call wallpaper current ;;
	esac ;;
special) # bead special [music|communication|todo|sysmon|bitwarden|specialws]
	exec qs -p "$share" ipc call special toggle "${2:-specialws}" ;;
lock) # bead lock [preview]: lock the screen (preview: show it for 20 s without locking)
	exec qs -p "$share" ipc call lock "${2:-lock}" ;;
island) # bead island [toggle|show|hide]
	exec qs -p "$share" ipc call island "${2:-toggle}" ;;
launcher) # bead launcher [toggle|open|close|search TEXT]
	if [ "${2:-}" = search ]; then exec qs -p "$share" ipc call launcher search "${3:-}"; fi
	exec qs -p "$share" ipc call launcher "${2:-toggle}" ;;
clip) exec qs -p "$share" ipc call launcher mode ";" ;;   # clipboard history (toggles)
emoji) exec qs -p "$share" ipc call launcher mode ":" ;;  # emoji picker (toggles)
ask) # bead ask QUESTION: the launcher asks Claude
	shift; exec qs -p "$share" ipc call launcher ask "$*" ;;
timer) # bead timer <25m|90s|1h30m> | stopwatch | toggle | stop
	case ${2:-} in
	stopwatch|toggle|stop) exec qs -p "$share" ipc call timer "$2" ;;
	"") echo "usage: bead timer <25m|90s|1h30m>|stopwatch|toggle|stop" >&2; exit 2 ;;
	*) exec qs -p "$share" ipc call timer start "$2" ;;
	esac ;;
discord) # bead discord [status|mute|deafen|leave|setup]: voice calls via Discord's local RPC
	case "${2:-status}" in
	setup)
		cfg="${XDG_CONFIG_HOME:-$HOME/.config}/bead/discord.json"
		if [ ! -f "$cfg" ]; then
			mkdir -p "${cfg%/*}"
			(umask 077; printf '{\n  "client_id": "PASTE_CLIENT_ID",\n  "client_secret": "PASTE_CLIENT_SECRET"\n}\n' > "$cfg")
		fi
		chmod 600 "$cfg"
		cat <<EOT
1. Open https://discord.com/developers/applications and click "New Application" (any name, e.g. bead).
2. OAuth2 page: copy the Client ID and Client Secret (Reset Secret if needed),
   and under Redirects add exactly: http://localhost   then Save.
3. Paste both into $cfg (private to you, mode 600).
4. bead picks it up by itself: Discord asks once to authorize the app. Click Authorize.
Then: bead discord status
EOT
		;;
	status|mute|deafen|leave) exec qs -p "$share" ipc call discord "${2:-status}" ;;
	*) echo "bead discord [status|mute|deafen|leave|setup]" >&2; exit 1 ;;
	esac ;;
log) exec qs -p "$share" log -f ;;
*) echo "usage: bead [start|stop|restart|claim|brightness up|down|notifs|dashboard|island|launcher|clip|emoji|ask|timer|shot|record|pick|wallpaper|special|lock|idle|log]" >&2; exit 2 ;;
esac

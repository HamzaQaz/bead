#!/bin/sh
# bead [start|stop|restart|log]: run the shell in the background.
share=${XDG_DATA_HOME:-$HOME/.local/share}/bead
case ${1:-start} in
start)
	qs -p "$share" kill >/dev/null 2>&1
	QT_SCALE_FACTOR=${BEAD_SCALE:-1.15} exec qs -p "$share" -n -d ;;
stop) exec qs -p "$share" kill ;;
restart) "$0" stop; exec "$0" start ;;
log) exec qs -p "$share" log -f ;;
*) echo "usage: bead [start|stop|restart|log]" >&2; exit 2 ;;
esac

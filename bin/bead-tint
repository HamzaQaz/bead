#!/usr/bin/env python3
"""Tint: bead's colours from your wallpaper.

  bead-tint [--variant vibrant|muted|mono] [--light] IMAGE

Picks the wallpaper's most telling hue (ImageMagick shrinks and quantises the
picture; colourful, common colours win) and builds a palette around it in
OKLCH, so lightness steps look even whatever the hue. Writes
$XDG_STATE_HOME/bead/scheme.json ({"colours": {name: "rrggbb"}}), which bead's
Theme watches, and the wallpaper's path to $XDG_STATE_HOME/bead/wallpaper-path.

Standard library only (plus the `magick` command).
"""
import json
import math
import os
import subprocess
import sys

STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "bead")


# ── OKLab / OKLCH (Björn Ottosson) ──
def _lin(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _gam(c):
    return 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055


def rgb_to_oklch(r, g, b):
    r, g, b = _lin(r / 255), _lin(g / 255), _lin(b / 255)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, math.hypot(A, B), math.degrees(math.atan2(B, A)) % 360


def _oklch_to_lin(L, C, H):
    a, b = C * math.cos(math.radians(H)), C * math.sin(math.radians(H))
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)


def oklch(L, C, H):
    """OKLCH to "rrggbb", pulling chroma in until it fits sRGB."""
    for _ in range(40):
        rgb = _oklch_to_lin(L, C, H)
        if all(-1e-4 <= c <= 1 + 1e-4 for c in rgb):
            break
        C *= 0.9
    return "".join(f"{round(max(0, min(1, _gam(max(0, c)))) * 255):02x}" for c in rgb)


# ── the wallpaper's colours ──
def swatches(path):
    """[(share, (r, g, b))] for the picture's main colours."""
    out = subprocess.run(
        ["magick", path + "[0]", "-resize", "160x160", "-colors", "24", "-format", "%c", "histogram:info:-"],
        capture_output=True, text=True, check=True).stdout
    found, total = [], 0
    for line in out.splitlines():
        line = line.strip()
        if ":" not in line or "(" not in line:
            continue
        count = int(line.split(":")[0])
        nums = line.split("(", 1)[1].split(")", 1)[0].replace("%", "").split(",")
        rgb = tuple(float(n) for n in nums[:3])
        if max(rgb) <= 1.0001 and "srgb" in line and "%" in line:  # percentages
            rgb = tuple(c * 2.55 for c in rgb)
        found.append((count, rgb))
        total += count
    return [(c / max(1, total), rgb) for c, rgb in found]


def seed(path):
    """(hue, chroma) of the colour that best stands for the picture."""
    best, best_score, fallback = None, -1, (250.0, 0.0)
    weight = 0
    for share, rgb in swatches(path):
        L, C, H = rgb_to_oklch(*rgb)
        if share > weight:
            weight, fallback = share, (H, C)
        if L < 0.2 or L > 0.95:  # near black / white says little
            continue
        score = C * math.sqrt(share)
        if score > best_score:
            best, best_score = (H, C), score
    return best if best and best[1] > 0.03 else fallback


def palette(hue, chroma, variant, light):
    # how strongly the accent and the greys take on the hue
    accent = {"vibrant": 0.16, "muted": 0.09, "mono": 0.0}[variant]
    tint = {"vibrant": 0.018, "muted": 0.01, "mono": 0.0}[variant]
    a = min(accent, max(chroma, 0.05) * 1.4) if variant != "mono" else 0
    if light:
        surf = [0.97, 0.94, 0.91, 0.88]
        ink, sub, line, acc = 0.25, 0.45, 0.62, 0.52
    else:
        surf = [0.15, 0.19, 0.22, 0.26]
        ink, sub, line, acc = 0.93, 0.76, 0.58, 0.80
    c = {
        "background": oklch(surf[0], tint, hue),
        "surface": oklch(surf[0], tint, hue),
        "surfaceContainerLow": oklch(surf[0] + (0.015 if not light else -0.015), tint, hue),
        "surfaceContainer": oklch(surf[1], tint, hue),
        "surfaceContainerHigh": oklch(surf[2], tint, hue),
        "surfaceContainerHighest": oklch(surf[3], tint, hue),
        "onSurface": oklch(ink, tint * 0.6, hue),
        "onSurfaceVariant": oklch(sub, tint, hue),
        "outline": oklch(line, tint, hue),
        "primary": oklch(acc, a, hue),
        "onPrimary": oklch(surf[0] if not light else 0.98, tint, hue),
        "secondary": oklch(acc - 0.04, a * 0.55, hue + 25),
        "tertiary": oklch(acc, max(a, 0.08) * 0.9, hue + 70),
        "error": oklch(0.70 if not light else 0.55, 0.17, 25),
        "success": oklch(0.76 if not light else 0.55, 0.15, 150),
        "term2": oklch(0.82 if not light else 0.6, 0.14, 85),  # warning
    }
    return c


def main(argv):
    variant, light, image = "vibrant", False, None
    it = iter(argv)
    for arg in it:
        if arg == "--variant":
            variant = next(it, "vibrant")
        elif arg == "--light":
            light = True
        elif arg in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            image = arg
    if variant not in ("vibrant", "muted", "mono"):
        print("bead-tint: --variant is vibrant, muted or mono", file=sys.stderr)
        return 2
    if not image or not os.path.isfile(image):
        print("bead-tint: give a wallpaper image", file=sys.stderr)
        return 2
    try:
        hue, chroma = seed(image)
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        print(f"bead-tint: couldn't read the image ({e})", file=sys.stderr)
        return 1
    os.makedirs(STATE, exist_ok=True)
    scheme = {"name": "tint", "variant": variant, "mode": "light" if light else "dark",
              "seed": {"hue": round(hue, 1), "chroma": round(chroma, 3)},
              "colours": palette(hue, chroma, variant, light)}
    for name, data in (("scheme.json", json.dumps(scheme, indent=2)), ("wallpaper-path", os.path.abspath(image))):
        tmp = os.path.join(STATE, name + ".tmp")
        with open(tmp, "w") as f:
            f.write(data)
        os.replace(tmp, os.path.join(STATE, name))
    print(f"tint: hue {hue:.0f}°, chroma {chroma:.3f} ({variant})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""Push-to-talk dictation for bead.

Run while the key is held: records the default mic (pw-record, 16 kHz mono)
and prints `level <0..1>` lines about 20 times a second. Writing `stop` to
stdin ends the recording, transcribes it with whisper.cpp (local, on the GPU
via Vulkan when ggml-vulkan is installed) and types the text into whatever
has keyboard focus with wtype. `cancel`, a press shorter than 0.3 s or a
recording with no speech in it types nothing. BEAD_DICTATE_DRY=1 or --no-type
prints the text without typing it (voice commands use that).

Out (JSON lines): {"level": x} | {"partial": "..."} | {"state": "transcribing"} |
                  {"text": "..."} | {"error": "..."}

--server URL     transcribe through a running whisper-server (fast, warm) instead
                 of starting whisper-cli; falls back to whisper-cli if it fails
--partials       while recording, transcribe what's been said so far about twice
                 a second and print it as {"partial": ...} (needs --server)
--live           type as you speak (needs --partials): see Live below; the final
                 transcript then corrects what was typed (backspacing over
                 revised words).
                 Typing waits for `free` on stdin: while the shortcut is held
                 its modifier (Super) is down, and typed letters would become
                 shortcuts. `free` also makes it hands-free: it stops by itself
                 after ~2 s of quiet (longer if you pause longer between words)
--until-silence  hands-free: stop by itself about a second after you finish
                 speaking (and give up if nothing is said within 8 s)
Only the Python standard library is used.
"""
import array
import json
import math
import os
import re
import shutil
import subprocess
import sys
import io
import tempfile
import threading
import time
import urllib.request
import uuid
import wave

RATE = 16000
MODEL = os.environ.get("BEAD_DICTATE_MODEL") or os.path.expanduser(
    "~/.local/share/bead-models/ggml-base.en.bin")
MIN_SECONDS = 0.3


def say(**kw):
    print(json.dumps(kw), flush=True)


def whisper_bin():
    for name in ("whisper-cli", "whisper-cpp", "main"):
        p = shutil.which(name)
        if p:
            return p
    return None


def clean(text: str) -> str:
    # whisper's non-speech tags: [BLANK_AUDIO], (wind blowing), [Music]…
    text = re.sub(r"\[[^\]]*\]|\([^)]*\)", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def arg(name):
    a = sys.argv
    return a[a.index(name) + 1] if name in a and a.index(name) + 1 < len(a) else None


def wav_bytes(pcm: bytes) -> bytes:
    b = io.BytesIO()
    with wave.open(b, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(pcm)
    return b.getvalue()


def via_server(url: str, pcm: bytes, timeout=10, prompt="") -> str:
    """POST a WAV to whisper-server's /inference (multipart, stdlib only).
    PROMPT: the text just before this audio, so a new stretch carries on the
    sentence (its case and punctuation) instead of starting a fresh one."""
    k = uuid.uuid4().hex
    parts = []
    fields = [("response_format", "json"), ("temperature", "0")]
    if prompt:
        fields.append(("prompt", prompt))
    for name, val in fields:
        parts.append(f'--{k}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{val}\r\n'.encode())
    parts.append(f'--{k}\r\nContent-Disposition: form-data; name="file"; filename="a.wav"\r\n'
                 f'Content-Type: audio/wav\r\n\r\n'.encode() + wav_bytes(pcm) + b"\r\n")
    parts.append(f"--{k}--\r\n".encode())
    req = urllib.request.Request(url.rstrip("/") + "/inference", b"".join(parts),
                                 {"Content-Type": f"multipart/form-data; boundary={k}"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r).get("text", "")


class Typer:
    """Types text into the focused window, keeping track of what it typed so
    a later, better guess can replace it: backspace to where they agree, then
    type the rest."""

    def __init__(self):
        self.typed = ""
        self.lock = threading.Lock()

    def to(self, target: str):
        with self.lock:
            c = 0
            while c < min(len(self.typed), len(target)) and self.typed[c] == target[c]:
                c += 1
            back = len(self.typed) - c
            if back:
                subprocess.run(["wtype"] + ["-k", "BackSpace"] * back, timeout=30)
            if target[c:]:
                subprocess.run(["wtype", "--", target[c:]], timeout=30)
            self.typed = target


def norm(w: str) -> str:
    """A word without case or punctuation: "Hello," and "hello" agree."""
    return re.sub(r"[^\w']", "", w.lower())


def same_start(a: list, b: list) -> int:
    n = 0
    while n < min(len(a), len(b)) and a[n] == b[n]:
        n += 1
    return n


def join(before: str, after: str) -> str:
    """Two stretches of dictation as one text. Whisper ends every stretch
    with a full stop; if the next one carries on in lower case, the pause
    was mid-sentence: drop it."""
    if not before:
        return after
    if not after:
        return before
    if after[0].islower() and before.endswith(".") and not before.endswith(".."):
        before = before[:-1]
    return before + " " + after


class Live:
    """What to type while you speak, from whisper's guesses at what's been
    said so far (one about every half second, each from the whole stretch).

    A word is typed once two guesses in a row agree on it, compared without
    case or punctuation (whisper keeps changing "world." to "world,", which
    used to stop live typing). While you're still talking the newest word is
    held back: at a slow pace it's often half a word ("beauty" for
    "beautiful"). If whisper changes its mind about a word already typed, the
    change is typed too once two guesses agree, up to REVISE words back;
    further back, typing waits and the final pass fixes it.

    After a pause, the stretch is finished: frozen, and later guesses only
    cover what comes after it (fast and steady however long you talk, and
    what's typed stops shifting)."""

    HOLD = 1     # words held back while you're mid-word
    REVISE = 3   # how far back a typed word may still be corrected
    QUIET = 0.5  # s of quiet that means the newest word is finished

    def __init__(self):
        self.frozen = ""   # finished stretches, typed
        self.words = []    # this stretch's typed words, as whisper wrote them
        self.prev = []     # the last guess, normalised
        self.last = []     # the last guess, as written
        self.stuck = False

    def text(self) -> str:
        return join(self.frozen, " ".join(self.words))

    def guess(self, t: str, quiet: float):
        cur = t.split()
        n = [norm(w) for w in cur]
        agree = same_start(self.prev, n)
        self.prev, self.last = n, cur
        if self.stuck:
            return
        k = min(agree, len(cur) - (0 if quiet >= self.QUIET else self.HOLD))
        typed = [norm(w) for w in self.words]
        d = same_start(typed, n)
        if d < len(typed):  # it changed its mind about something typed
            if len(typed) - d > self.REVISE:
                self.stuck = True  # too far back to fix live: the final pass will
            elif k > d:
                self.words = cur[:k]  # the new version is agreed: retype from there
            return
        # same words so far (maybe newer case or punctuation): take them, and more
        self.words = cur[:max(k, len(typed))]

    def finish_stretch(self) -> bool:
        """Freeze this stretch if all of it is typed (call after a pause)."""
        if self.stuck or not self.words or len(self.words) < len(self.last):
            return False
        self.frozen, self.words, self.prev, self.last = self.text(), [], [], []
        return True


def main():
    server = arg("--server")
    partials = server and "--partials" in sys.argv
    typing = not os.environ.get("BEAD_DICTATE_DRY") and "--no-type" not in sys.argv
    live = partials and typing and "--live" in sys.argv
    until_silence = "--until-silence" in sys.argv
    typer = Typer()
    live_text = Live()
    wbin = whisper_bin()
    if not wbin and not server:
        say(error="whisper.cpp isn't installed (pacman -S whisper-cpp ggml-vulkan)")
        return 1
    if not os.path.exists(MODEL):
        say(error="no speech model at " + MODEL)
        return 1

    run = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    work = tempfile.mkdtemp(prefix="dictate-", dir=run)
    os.chmod(work, 0o700)  # what you said stays yours
    wav_path = os.path.join(work, "rec.wav")

    rec = subprocess.Popen(
        ["pw-record", "--rate", str(RATE), "--channels", "1", "--format", "s16",
         "--raw", "-"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    started = time.monotonic()
    stop = threading.Event()
    cancelled = threading.Event()

    def commands():
        for line in sys.stdin:
            cmd = line.strip()
            if cmd == "free":
                free_at[0] = time.monotonic()
                free.set()
                continue
            if cmd == "cancel":
                cancelled.set()
            if cmd in ("stop", "cancel"):
                break
        stop.set()  # stdin closed counts as stop
    threading.Thread(target=commands, daemon=True).start()

    free = threading.Event()  # the key's been let go: safe to type, and hands-free
    free_at = [0.0]
    frames = bytearray()
    lock = threading.Lock()
    heard_speech = threading.Event()
    last_loud = [started]  # when you last made a sound (time.monotonic())
    loud_at = [0]          # ...and where in the recording (bytes)
    seg = [0]              # where the stretch being guessed at starts (bytes)
    # speech-level chunks since then: with the text before it as a prompt,
    # whisper makes up a carrying-on from a cough or a click, so a stretch
    # needs real speech before it's transcribed
    loud_in_seg = [0]

    def partial_loop():
        last = 0
        while not stop.is_set():
            time.sleep(0.45)
            if stop.is_set() or not heard_speech.is_set():
                continue
            with lock:
                n = len(frames)
                if n == last or loud_in_seg[0] < 3:
                    continue  # nothing new, or no speech since the last stretch
                pcm = bytes(frames[seg[0]:][-RATE * 2 * 30:])  # the last 30 s is plenty
            last = n
            quiet = time.monotonic() - last_loud[0]
            try:
                t = clean(via_server(server, pcm, timeout=5, prompt=live_text.frozen[-200:]))
            except Exception:
                continue
            if stop.is_set():
                continue
            say(partial=join(live_text.frozen, t))
            # live typing (only while this stretch fits whisper's 30 s window)
            if live and free.is_set() and n - seg[0] < RATE * 2 * 28 and t:
                live_text.guess(t, quiet)
                if quiet >= 0.7 and n - seg[0] > RATE * 2 and live_text.finish_stretch():
                    seg[0] = n  # a pause after it all got typed: start a new stretch
                    loud_in_seg[0] = 0
                with typer.lock:
                    if stop.is_set():
                        continue
                if live_text.text():
                    typer.to(live_text.text() + " ")
    if partials:
        threading.Thread(target=partial_loop, daemon=True).start()
    chunk = RATE // 20 * 2  # 50 ms of s16
    smooth = 0.0
    peak = 0.0
    loud = 0  # 50 ms chunks at speech level: silence alone makes whisper invent words ("you")
    # the longest pause between words so far: slow speakers pause longer, so
    # stopping on its own waits longer for them
    longest_gap = 0.0
    while not stop.is_set():
        b = rec.stdout.read(chunk)
        if not b:
            break
        with lock:
            frames += b
        a = array.array("h", b[: len(b) // 2 * 2])
        if a:
            rms = math.sqrt(sum(s * s for s in a) / len(a)) / 32768
            # speech sits around 0.02-0.2 rms: map to 0..1 on a log scale
            lvl = max(0.0, min(1.0, (math.log10(max(rms, 1e-4)) + 3) / 2.2))
            smooth = max(lvl, smooth * 0.75)
            peak = max(peak, lvl)
            if lvl > 0.18:  # quiet headset mics sit around 0.2-0.4 when you talk
                loud += 1
                now = time.monotonic()
                if heard_speech.is_set() and now - last_loud[0] < 4:
                    longest_gap = max(longest_gap, now - last_loud[0])
                last_loud[0] = now
                loud_at[0] = len(frames)
                loud_in_seg[0] += 1
                if loud >= 3:
                    heard_speech.set()
            say(level=round(smooth, 3))
            if free.is_set():
                now = time.monotonic()
                if heard_speech.is_set() and now - max(last_loud[0], free_at[0]) > min(4.0, max(2.0, longest_gap * 1.5)):
                    break  # hands-free: you've stopped talking
                if not heard_speech.is_set() and now - free_at[0] > 8:
                    cancelled.set()
                    break
            if until_silence:
                now = time.monotonic()
                if heard_speech.is_set() and now - last_loud[0] > min(2.5, max(1.1, longest_gap * 1.5)):
                    break  # you've finished
                if not heard_speech.is_set() and now - started > 8:
                    cancelled.set()
                    break
    stop.set()  # (also ends the partials: the until-silence path leaves the loop itself)
    rec.terminate()
    try:
        rec.wait(1)
    except subprocess.TimeoutExpired:
        rec.kill()

    try:
        if (cancelled.is_set() or time.monotonic() - started < MIN_SECONDS
                or len(frames) < RATE * 2 * MIN_SECONDS or loud < 3):
            if typing and typer.typed:
                typer.to("")  # cancelled: take back what was typed live
            say(text="", peak=round(peak, 3), loud=loud)
            return 0
        say(state="transcribing")
        text = None
        if server:
            try:
                if seg[0]:  # typed live in stretches: only the last one is left to do
                    tail = ""
                    if loud_in_seg[0] >= 3 and loud_at[0] > seg[0]:
                        tail = clean(via_server(server, bytes(frames[seg[0]:]), timeout=30,
                                                prompt=live_text.frozen[-200:]))
                    text = join(live_text.frozen, tail)
                else:
                    text = clean(via_server(server, bytes(frames), timeout=30))
            except Exception:
                text = None  # fall back to whisper-cli
        if text is None:
            if not wbin:
                say(error="whisper.cpp isn't installed (pacman -S whisper-cpp ggml-vulkan)")
                return 1
            with wave.open(wav_path, "wb") as w:
                w.setnchannels(1)
                w.setsampwidth(2)
                w.setframerate(RATE)
                w.writeframes(bytes(frames))
            r = subprocess.run(
                [wbin, "-m", MODEL, "-f", wav_path, "-l", "en", "-nt", "-np",
                 "-t", str(min(4, os.cpu_count() or 4))],
                capture_output=True, text=True, timeout=60)
            if r.returncode != 0:
                say(error=(r.stderr.strip().splitlines() or ["whisper failed"])[-1][:200])
                return 1
            text = clean(r.stdout)
        if typing and (text or typer.typed):
            # type into whatever has focus (correcting anything typed live); a
            # trailing space lets the next dictation carry on the sentence
            typer.to(text + " " if text else "")
        say(text=text)
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())

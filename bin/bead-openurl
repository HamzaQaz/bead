#!/bin/sh
# bead-openurl <url>: open a link in the default browser and bring that browser
# forward. xdg-open hands the link to a running browser, which opens a tab
# where it is (often on another workspace) without Hyprland switching there.
# Used by bead's links (the update review's "Changes", the App Store, pop-ups).
[ -n "${1:-}" ] || { echo "usage: bead-openurl <url>" >&2; exit 2; }
case $1 in http://* | https://* | mailto:*) ;; *) echo "not a web link: $1" >&2; exit 2 ;; esac
xdg-open "$1" >/dev/null 2>&1 &
command -v hyprctl >/dev/null && command -v jq >/dev/null || exit 0

# the browser's window class: its desktop file's StartupWMClass, else the file's name
desk=$(xdg-settings get default-web-browser 2>/dev/null)
[ -n "$desk" ] || exit 0
class=""
for d in "${XDG_DATA_HOME:-$HOME/.local/share}" /usr/local/share /usr/share /var/lib/flatpak/exports/share "$HOME/.local/share/flatpak/exports/share"; do
	f=$d/applications/$desk
	[ -f "$f" ] && { class=$(sed -n 's/^StartupWMClass=//p' "$f" | head -1); break; }
done
[ -n "$class" ] || class=${desk%.desktop}

# its most recently used window, once the link has landed (up to ~2 s: a browser
# that wasn't running opens its own window, focused already)
i=0
while [ $i -lt 10 ]; do
	addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg c "$class" \
		'[.[] | select((.class | ascii_downcase) == ($c | ascii_downcase))] | sort_by(.focusHistoryID) | .[0].address // empty')
	if [ -n "$addr" ]; then
		sleep 0.25
		hyprctl dispatch focuswindow "address:$addr" >/dev/null
		exit 0
	fi
	sleep 0.2
	i=$((i + 1))
done

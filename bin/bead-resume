#!/usr/bin/env bash
# After the machine resumes, check bead for Quickshell's resume bug (it loses
# its screens and every module throws "Cannot read property ... of null") and
# restart it only if that happened, so timers and the like survive a normal
# resume. If the screen was locked, lock it again straight away: Hyprland's
# allow_session_lock_restore keeps the session locked in between.
# Run by systemd/bead-resume.service.

set -uo pipefail
# the shell sits next to this script's folder: <prefix>/bin → <prefix>/share/bead
share=$(cd "$(dirname "$(readlink -f "$0")")/../share/bead" 2>/dev/null && pwd) || share=${XDG_DATA_HOME:-$HOME/.local/share}/bead
bead=$(dirname "$(readlink -f "$0")")/bead
before=0

dbus-monitor --system \
    "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" 2>/dev/null |
while read -r line; do
    case $line in
    *"boolean true"*) # going down: note how far the log goes
        before=$(qs -p "$share" log 2>/dev/null | wc -l) ;;
    *"boolean false"*) # back: let the outputs settle, then look
        sleep 3
        pgrep -f "qs -p $share" >/dev/null || continue
        # (no grep -q: under pipefail its early exit would SIGPIPE the log
        # reader and hide the very flood of errors we're looking for)
        if qs -p "$share" log 2>/dev/null | tail -n +"$((before + 1))" | grep -E 'of null|TypeError' >/dev/null; then
            locked=$(qs -p "$share" ipc call lock isLocked 2>/dev/null)
            # restart through Hyprland, so the new bead isn't part of this
            # service (systemd would kill it whenever the service restarts)
            then_lock=""; [ "$locked" = true ] && then_lock=" && sleep 2 && $bead lock"
            hyprctl dispatch "hl.dsp.exec_cmd(\"$bead restart$then_lock\")" >/dev/null
        fi ;;
    esac
done

#!/bin/sh
# bead-sysupdate [repo] [aur] [flatpak]: the system update (or one install, below), run by
# services/Updates.qml and shown in the island (modules/island/UpdateView.qml).
#
# No terminal and no questions: pacman and paru run with --noconfirm (their
# default answers), paru skips its PKGBUILD review (bead shows the AUR
# changes before you start). Passwords go through polkit (pkexec), which
# bead itself answers as your polkit agent (services/Polkit.qml).
#
# Prints the tools' own output, plus "@@stage <name>" before each stage and
# "@@done" or "@@fail <stage> <code>" at the end. Exits with the failing code.
set -u
export LC_ALL=C   # English output, for services/sysupdate.js to read
fail() { echo "@@fail $1 $2"; exit "$2"; }

# bead-sysupdate install repo|flathub|aur <name>: one app, for the App Store
# (services/Store.qml); the same markers, with the stage "install"
if [ "${1:-}" = install ]; then
	src=${2:?source} name=${3:?name}
	echo "@@stage install"
	case $src in
	repo) pkexec stdbuf -oL -eL pacman -S --needed --noconfirm --noprogressbar -- "$name" 2>&1 || fail install $? ;;
	flatpak|flathub) stdbuf -oL -eL flatpak install -y --noninteractive flathub "$name" 2>&1 || fail install $? ;;
	aur)
		if command -v paru >/dev/null; then
			stdbuf -oL -eL paru -S --needed --noconfirm --skipreview --noprogressbar --sudo pkexec --nosudoloop -- "$name" 2>&1 || fail install $?
		elif command -v yay >/dev/null; then
			stdbuf -oL -eL yay -S --needed --noconfirm --noprogressbar --sudo pkexec --nosudoloop --answerdiff None --answerclean None -- "$name" 2>&1 || fail install $?
		else echo "error: no AUR helper (paru or yay)"; fail install 127; fi ;;
	*) echo "error: unknown source $src"; fail install 2 ;;
	esac
	echo "@@done"
	exit 0
fi

# bead-sysupdate rollback <file>...: put back older versions (the update
# history's Undo, services/Updates.qml): only package files from pacman's cache
# or an AUR helper's build folder, installed with pacman -U; the stage "rollback"
if [ "${1:-}" = rollback ]; then
	shift
	[ $# -gt 0 ] || { echo "error: nothing to roll back"; fail rollback 2; }
	for f in "$@"; do
		case $f in
		/var/cache/pacman/pkg/*.pkg.tar.* | "$HOME"/.cache/paru/clone/*.pkg.tar.* | "$HOME"/.cache/yay/*.pkg.tar.*) ;;
		*) echo "error: not a cached package: $f"; fail rollback 2 ;;
		esac
		case $f in *.sig | *..*) echo "error: not a package file: $f"; fail rollback 2 ;; esac
		[ -f "$f" ] || { echo "error: no longer in the cache: $f"; fail rollback 2; }
	done
	echo "@@stage rollback"
	pkexec stdbuf -oL -eL pacman -U --noconfirm --noprogressbar -- "$@" 2>&1 || fail rollback $?
	echo "@@done"
	exit 0
fi

stages=${*:-repo aur flatpak}
# held versions (rolled back from): BEAD_IGNORE="a,b" keeps them out of this update
ignore=${BEAD_IGNORE:+--ignore $BEAD_IGNORE}

for s in $stages; do
	case $s in
	repo)
		echo "@@stage repo"
		# stdbuf: line by line, not in blocks at the end
		pkexec stdbuf -oL -eL pacman -Syu --noconfirm --noprogressbar $ignore 2>&1 || fail repo $?
		;;
	aur)
		helper=$(command -v paru || command -v yay) || continue
		echo "@@stage aur"
		if [ "${helper##*/}" = paru ]; then
			stdbuf -oL -eL paru -Sua --noconfirm --skipreview --noprogressbar --sudo pkexec --nosudoloop $ignore 2>&1 || fail aur $?
		else
			stdbuf -oL -eL yay -Sua --noconfirm --noprogressbar --sudo pkexec --nosudoloop --answerdiff None --answerclean None $ignore 2>&1 || fail aur $?
		fi
		;;
	flatpak)
		command -v flatpak >/dev/null || continue
		echo "@@stage flatpak"
		stdbuf -oL -eL flatpak update -y --noninteractive 2>&1 || fail flatpak $?
		;;
	esac
done
echo "@@done"
